# Copy to .env (gitignored). Nothing here is required for `--dry-run`.

# NEAR AI Cloud (OpenAI-compatible). Unset => deterministic mock LLM.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Testnet accounts (defaults shown)
NEAR_NETWORK=testnet
# comma-separated failover list
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
ROOT_ACCOUNT=arifnovrian.testnet
REDTEAM_CONTRACT=redteam.arifnovrian.testnet
TUSDC_CONTRACT=tusdc.arifnovrian.testnet

# Where setup writes function-call keys + x25519 keys (0600, gitignored)
AGENT_KEYS_DIR=.keys
